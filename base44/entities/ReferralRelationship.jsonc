{
  "name": "ReferralRelationship",
  "type": "object",
  "properties": {
    "referrer_user_id": {
      "type": "string"
    },
    "referred_user_id": {
      "type": "string"
    },
    "referrer_member_number": {
      "type": "string"
    },
    "referred_member_number": {
      "type": "string"
    },
    "level": {
      "type": "integer"
    },
    "is_qualified": {
      "type": "boolean",
      "default": false
    },
    "relationship_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "referrer_user_id",
    "referred_user_id",
    "level",
    "relationship_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "data.referred_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}