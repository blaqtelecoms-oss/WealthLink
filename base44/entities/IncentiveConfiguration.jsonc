{
  "name": "IncentiveConfiguration",
  "type": "object",
  "properties": {
    "programme_enabled": {
      "type": "boolean",
      "default": false
    },
    "direct_percentage": {
      "type": "number",
      "default": 10
    },
    "leadership_percentage": {
      "type": "number",
      "default": 3
    },
    "qualification_requirement": {
      "type": "integer",
      "default": 10
    },
    "maximum_leadership_levels": {
      "type": "integer",
      "default": 1
    },
    "minimum_qualifying_transaction": {
      "type": "number",
      "default": 0
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    },
    "kyc_required_for_investment": {
      "type": "boolean",
      "default": true
    },
    "kyc_required_for_withdrawal": {
      "type": "boolean",
      "default": true
    },
    "bank_verification_required": {
      "type": "boolean",
      "default": true
    },
    "leaderboard_enabled": {
      "type": "boolean",
      "default": true
    },
    "reversal_rule": {
      "type": "string",
      "enum": [
        "REVERSE_UNPAID",
        "HOLD_FOR_REVIEW"
      ],
      "default": "REVERSE_UNPAID"
    }
  },
  "required": [
    "programme_enabled",
    "direct_percentage",
    "leadership_percentage",
    "qualification_requirement",
    "maximum_leadership_levels",
    "approval_required"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}