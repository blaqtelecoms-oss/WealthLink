{
  "name": "Withdrawal",
  "type": "object",
  "properties": {
    "withdrawal_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "bank_account_id": {
      "type": "string"
    },
    "bank_account_masked": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "REQUESTED",
        "UNDER_REVIEW",
        "APPROVED",
        "PROCESSING",
        "PAID",
        "REJECTED",
        "CANCELLED"
      ]
    },
    "requested_date": {
      "type": "string",
      "format": "date-time"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time"
    },
    "payment_reference": {
      "type": "string"
    }
  },
  "required": [
    "withdrawal_id",
    "member_id",
    "amount",
    "bank_account_id",
    "status",
    "requested_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "FINANCE_ADMIN"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "FINANCE_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}