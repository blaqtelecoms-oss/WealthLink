{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "account_holder": {
      "type": "string"
    },
    "account_number_masked": {
      "type": "string"
    },
    "account_fingerprint": {
      "type": "string"
    },
    "account_type": {
      "type": "string"
    },
    "branch_code": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING_VERIFICATION",
        "VERIFIED",
        "REJECTED",
        "LOCKED"
      ]
    }
  },
  "required": [
    "member_id",
    "bank_name",
    "account_holder",
    "account_number_masked",
    "account_fingerprint",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "FINANCE_ADMIN"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "FINANCE_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}