{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "MEMBER",
        "GROWTH_PARTNER",
        "SUPPORT",
        "COMPLIANCE_OFFICER",
        "FINANCE_ADMIN",
        "ADMIN",
        "SUPER_ADMIN"
      ],
      "default": "MEMBER"
    },
    "mobile_number": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "member_number": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by_member_id": {
      "type": "string"
    },
    "member_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "CLOSED"
      ],
      "default": "ACTIVE"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "UNDER_REVIEW",
        "VERIFIED",
        "REJECTED",
        "EXPIRED"
      ],
      "default": "PENDING"
    },
    "leadership_level": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "role",
    "app_role"
  ]
}