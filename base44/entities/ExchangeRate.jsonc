{
  "name": "ExchangeRate",
  "type": "object",
  "properties": {
    "base_currency": {
      "type": "string"
    },
    "quote_currency": {
      "type": "string"
    },
    "rate": {
      "type": "number"
    },
    "is_illustrative": {
      "type": "boolean",
      "default": true
    },
    "effective_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "base_currency",
    "quote_currency",
    "rate",
    "effective_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}