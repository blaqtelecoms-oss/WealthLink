{
  "name": "KYCSubmission",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "IDENTITY",
        "PROOF_OF_ADDRESS",
        "BANK_CONFIRMATION"
      ]
    },
    "document_uri": {
      "type": "string"
    },
    "identity_fingerprint": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "UNDER_REVIEW",
        "VERIFIED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "review_notes": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "member_id",
    "document_type",
    "document_uri",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "COMPLIANCE_OFFICER"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "COMPLIANCE_OFFICER"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}