{
  "name": "Investment",
  "type": "object",
  "properties": {
    "investment_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "investment_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "exchange_rate": {
      "type": "number"
    },
    "zar_equivalent": {
      "type": "number"
    },
    "transaction_reference": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RECEIVED",
        "FAILED",
        "REFUNDED"
      ]
    },
    "investment_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PAYMENT_RECEIVED",
        "ACTIVE",
        "MATURED",
        "CANCELLED",
        "REFUNDED",
        "REVERSED"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "maturity_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "investment_id",
    "member_id",
    "product_id",
    "investment_amount",
    "currency",
    "exchange_rate",
    "zar_equivalent",
    "transaction_reference",
    "payment_status",
    "investment_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}