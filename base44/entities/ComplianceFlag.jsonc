{
  "name": "ComplianceFlag",
  "type": "object",
  "properties": {
    "flag_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "DUPLICATE_ACCOUNT",
        "TRANSACTION_PATTERN",
        "REFERRAL_ANOMALY",
        "NETWORK_ACTIVITY",
        "REVERSED_INVESTMENT",
        "KYC_REVIEW",
        "RAPID_CREATION"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "FLAGGED_FOR_REVIEW",
        "INVESTIGATING",
        "CLEARED",
        "ACTION_REQUIRED"
      ]
    },
    "reason": {
      "type": "string"
    },
    "related_entity": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    }
  },
  "required": [
    "flag_id",
    "member_id",
    "category",
    "severity",
    "status",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "COMPLIANCE_OFFICER"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "COMPLIANCE_OFFICER"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "COMPLIANCE_OFFICER"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}