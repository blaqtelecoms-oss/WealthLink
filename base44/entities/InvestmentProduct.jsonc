{
  "name": "InvestmentProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "minimum_investment": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "term_months": {
      "type": "integer"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH"
      ]
    },
    "return_method": {
      "type": "string"
    },
    "rate": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "disclosure": {
      "type": "string"
    },
    "terms": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name",
    "minimum_investment",
    "currency",
    "risk_level",
    "disclosure"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}