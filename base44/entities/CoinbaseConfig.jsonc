{
  "name": "CoinbaseConfig",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE"
      ],
      "default": "ACTIVE"
    },
    "default_chain_id": {
      "type": "integer",
      "default": 8453
    },
    "supported_tokens": {
      "type": "string",
      "default": "ETH,USDC"
    },
    "treasury_wallet_address": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "default_chain_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}