{
  "name": "LegalDocument",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string",
      "enum": [
        "TERMS_CONDITIONS",
        "PRIVACY_POLICY",
        "RISK_DISCLOSURE",
        "PRODUCT_DISCLOSURE",
        "REFERRAL_TERMS",
        "WITHDRAWAL_TERMS",
        "KYC_AML_NOTICE",
        "COMPLAINTS_PROCEDURE"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "document_type",
    "title",
    "content",
    "version"
  ],
  "rls": {
    "read": {
      "data.is_published": true
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}