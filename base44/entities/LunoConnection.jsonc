{
  "name": "LunoConnection",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_CONNECTED",
        "CONNECTED",
        "CONNECTION_ERROR",
        "DISCONNECTED"
      ],
      "default": "NOT_CONNECTED"
    },
    "api_key_id": {
      "type": "string"
    },
    "api_secret_encrypted": {
      "type": "string"
    },
    "connected_date": {
      "type": "string",
      "format": "date-time"
    },
    "disconnected_date": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "member_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "FINANCE_ADMIN"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}