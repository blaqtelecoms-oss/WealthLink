{
  "name": "BinanceConfig",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE"
      ],
      "default": "INACTIVE"
    },
    "environment": {
      "type": "string",
      "enum": [
        "PRODUCTION",
        "TEST"
      ],
      "default": "TEST"
    },
    "api_base_url": {
      "type": "string",
      "default": "https://api.binance.com"
    },
    "connection_mode": {
      "type": "string",
      "default": "READ_ONLY"
    },
    "allowed_permissions": {
      "type": "string",
      "default": "USER_DATA"
    },
    "last_sync_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "status",
    "environment",
    "connection_mode",
    "allowed_permissions"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}