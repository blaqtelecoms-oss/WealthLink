{
  "name": "VirtualInvestment",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "period_days": {
      "type": "integer"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    },
    "daily_rate": {
      "type": "number"
    },
    "index_name": {
      "type": "string"
    },
    "index_annual_rate": {
      "type": "number"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "period_days",
    "start_date",
    "end_date",
    "status",
    "daily_rate"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}