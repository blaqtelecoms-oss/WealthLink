{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "previous_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_role",
    "action",
    "entity",
    "entity_id",
    "timestamp"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "COMPLIANCE_OFFICER"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "app_role": "SUPER_ADMIN"
      }
    },
    "delete": {
      "user_condition": {
        "app_role": "SUPER_ADMIN"
      }
    }
  }
}