{
  "name": "FundingTransaction",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "zar_value": {
      "type": "number"
    },
    "funding_method": {
      "type": "string",
      "enum": [
        "BINANCE_P2P",
        "CAPITEC_PAY",
        "BANK_TRANSFER",
        "OTHER"
      ]
    },
    "binance_status": {
      "type": "string"
    },
    "wealthlink_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "SUBMITTED",
        "AWAITING_VERIFICATION",
        "CONFIRMED",
        "FAILED",
        "CANCELLED",
        "REVIEW"
      ]
    },
    "blockchain_txid": {
      "type": "string"
    },
    "submitted_reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "transaction_id",
    "member_id",
    "date",
    "currency",
    "amount",
    "funding_method",
    "wealthlink_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "FINANCE_ADMIN"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "FINANCE_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}